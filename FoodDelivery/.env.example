# Copy this file to `.env` (same folder as docker-compose.yml) and set real
# values. `.env` is gitignored and must NOT be committed.

# Config Server access used by config clients
CONFIG_SERVER_USERNAME=config-client
CONFIG_SERVER_PASSWORD=changeit

# Config Server backend profile: native | git
CONFIG_SERVER_PROFILE=native

# Optional remote Git config repository (used when CONFIG_SERVER_PROFILE=git)
CONFIG_GIT_URI=
CONFIG_GIT_LABEL=main
CONFIG_GIT_SEARCH_PATHS=
CONFIG_GIT_USERNAME=
CONFIG_GIT_PASSWORD=

# -- PostgreSQL credentials (shared by order/delivery/customer services) --
DB_USER=postgres
DB_PASSWORD=root

# Shared JWT signing secret (required; no default fallback in app config)
JWT_SECRET=replace-with-a-long-random-secret

# -- Keycloak admin console (http://localhost:8180) --
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
