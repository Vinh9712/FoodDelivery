# Copy this file to `.env` (same folder as docker-compose.yml) and set real
# values. `.env` is gitignored and must NOT be committed.

# Config Server access used by config clients
CONFIG_SERVER_USERNAME=config-client
CONFIG_SERVER_PASSWORD=changeit

# Config Server backend profile: native | git
CONFIG_SERVER_PROFILE=native

# Optional remote Git config repository (used when CONFIG_SERVER_PROFILE=git)
CONFIG_GIT_URI=
CONFIG_GIT_LABEL=main
CONFIG_GIT_SEARCH_PATHS=
CONFIG_GIT_USERNAME=
CONFIG_GIT_PASSWORD=

# -- PostgreSQL credentials (shared by order/delivery/customer services) --
DB_USER=postgres
DB_PASSWORD=root

# Keep `user_db` temporarily when starting against a legacy PostgreSQL volume.
CUSTOMER_DB_NAME=customer_db
PAYMENT_DB_NAME=payment_db
PAYMENT_SIMULATOR_MAX_AMOUNT=500000
PAYMENT_RECONCILIATION_DELAY_MS=30000

# JWT signing/validation contract. Generate and configure a persistent RSA key
# pair for any multi-replica or non-development deployment.
JWT_ISSUER=food-delivery-auth
JWT_AUDIENCE=food-delivery-api
JWT_KEY_ID=food-delivery-auth-1
JWT_PRIVATE_KEY_BASE64=
JWT_PUBLIC_KEY_BASE64=
JWT_EXPIRATION_MS=900000

# Service-to-service credential for /internal/** APIs.
INTERNAL_SERVICE_SECRET=replace-with-a-long-random-internal-service-secret

# Shared only by gateway and internal services. Gateway injects it; services reject forged identity headers without it.
INTERNAL_GATEWAY_SECRET=replace-with-another-long-random-secret

# Server-owned order pricing. Never accept this value from public API clients.
ORDER_DELIVERY_FEE=15000

# -- Optional legacy Keycloak admin console (http://localhost:8180) --
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
