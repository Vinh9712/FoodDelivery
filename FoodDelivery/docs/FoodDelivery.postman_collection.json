{
  "info": {
    "_postman_id": "fooddelivery-2026",
    "name": "FoodDelivery Platform API",
    "description": "Complete API collection for FoodDelivery microservices platform.\n\n## Setup\n1. Import this collection into Postman\n2. Set `baseUrl` (default: http://localhost:8080)\n3. Run an authentication-service login request first; access and refresh tokens are saved automatically\n4. Protected requests use `{{token}}`\n\nPayment, delivery scheduling and notification sending are internal Saga APIs and are intentionally not exposed through the gateway.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" },
    { "key": "restaurantId", "value": "22222222-2222-2222-2222-222222222222", "type": "string" },
    { "key": "menuItemId", "value": "33333333-3333-3333-3333-333333333333", "type": "string" },
    { "key": "orderIdempotencyKey", "value": "order-demo-1", "type": "string" }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "[Auth] Login Customer",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('token', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "  console.log('Token saved to collection variable {{token}}');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Login through authentication-service. Tokens are saved to collection variables."
          }
        },
        {
          "name": "[Auth] Login Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('token', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "[Customer Service] Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"Password123!\",\n  \"fullName\": \"Nguyen Van A\",\n  \"phone\": \"0901234567\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "Register a new customer (public endpoint, no token needed)"
          }
        },
        {
          "name": "[Customer Service] Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.accessToken) {",
                  "  pm.collectionVariables.set('token', json.data.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', json.data.refreshToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Login the newly registered customer through authentication-service"
          }
        },
        {
          "name": "[Customer Service] Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "[Customer Service] Logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}" },
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "👤 Customers",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/customers/me"
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Nguyen\",\n  \"lastName\": \"Van B\",\n  \"phone\": \"0909999999\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/customers/me"
          }
        },
        {
          "name": "Get My Addresses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/customers/me/addresses"
          }
        },
        {
          "name": "Add Address",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Home\",\n  \"street\": \"123 Nguyen Hue\",\n  \"district\": \"District 1\",\n  \"city\": \"Ho Chi Minh City\",\n  \"isDefault\": true\n}"
            },
            "url": "{{baseUrl}}/api/v1/customers/me/addresses"
          }
        }
      ]
    },
    {
      "name": "🍜 Restaurant",
      "item": [
        {
          "name": "List Restaurants",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/restaurant?page=0&size=10",
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Create Restaurant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pho 24\",\n  \"description\": \"Vietnamese Pho restaurant\",\n  \"address\": \"456 Le Loi, District 1, HCMC\",\n  \"phone\": \"02812345678\",\n  \"openTime\": \"07:00\",\n  \"closeTime\": \"22:00\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/restaurant"
          }
        },
        {
          "name": "Get Restaurant by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/restaurant/{{restaurantId}}"
          }
        },
        {
          "name": "Get Menu",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/restaurant/{{restaurantId}}/menu"
          }
        },
        {
          "name": "Add Menu Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pho Bo\",\n  \"description\": \"Traditional beef noodle soup\",\n  \"price\": 75000,\n  \"currency\": \"VND\",\n  \"categoryId\": null\n}"
            },
            "url": "{{baseUrl}}/api/v1/restaurant/{{restaurantId}}/menu/items"
          }
        }
      ]
    },
    {
      "name": "📦 Orders",
      "item": [
        {
          "name": "Create Order ⭐",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('orderId', json.id);",
                  "  console.log('Order ID saved:', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Idempotency-Key", "value": "{{orderIdempotencyKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"deliveryAddress\": \"123 Le Loi, District 1\",\n  \"items\": [\n    {\n      \"menuItemId\": \"{{menuItemId}}\",\n      \"quantity\": 2\n    }\n  ]\n}"
            },
            "url": "{{baseUrl}}/api/v1/orders",
            "description": "Creates an order for the authenticated CUSTOMER. Identity and prices are server-owned. Reuse the same Idempotency-Key to safely retry without creating or charging twice. orderId is auto-saved to {{orderId}}."
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}"
          }
        }
      ]
    },
    {
      "name": "🔔 Notifications",
      "item": [
        {
          "name": "[Admin] Get All Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/notifications",
            "description": "ADMIN only. Returns recent notification logs."
          }
        }
      ]
    },
    {
      "name": "🏥 Health Checks",
      "item": [
        {
          "name": "Gateway Health",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/actuator/health"
          }
        },
        {
          "name": "Eureka Health",
          "request": {
            "method": "GET",
            "url": "http://localhost:8761/actuator/health"
          }
        },
        {
          "name": "Config Server Health",
          "request": {
            "method": "GET",
            "url": "http://localhost:8888/actuator/health"
          }
        },
        {
          "name": "Order Service Health (direct)",
          "request": {
            "method": "GET",
            "url": "http://localhost:8083/actuator/health"
          }
        },
        {
          "name": "Payment Service Health (direct)",
          "request": {
            "method": "GET",
            "url": "http://localhost:8085/actuator/health"
          }
        },
        {
          "name": "Notification Service Health (direct)",
          "request": {
            "method": "GET",
            "url": "http://localhost:8086/actuator/health"
          }
        }
      ]
    }
  ]
}
