{
  "info": {
    "_postman_id": "fooddelivery-2026",
    "name": "FoodDelivery Platform API",
    "description": "Complete API collection for FoodDelivery microservices platform.\n\n## Setup\n1. Import this collection into Postman\n2. Set the environment variables (or use the included defaults):\n   - `baseUrl`: http://localhost:8080 (API Gateway)\n   - `keycloakUrl`: http://localhost:8180\n3. Run **[Auth] Get Token** first — the token is auto-saved to `{{token}}`\n4. All other requests use `{{token}}` automatically\n\n## End-to-End Flow\n1. Get Token → 2. Create Order → 3. Get Payment → 4. Get Notifications",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string" },
    { "key": "keycloakUrl", "value": "http://localhost:8180", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" },
    { "key": "customerId", "value": "11111111-1111-1111-1111-111111111111", "type": "string" },
    { "key": "restaurantId", "value": "22222222-2222-2222-2222-222222222222", "type": "string" }
  ],
  "item": [
    {
      "name": "🔐 Auth",
      "item": [
        {
          "name": "[Keycloak] Get Token (customer1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "  pm.collectionVariables.set('token', json.access_token);",
                  "  console.log('Token saved to collection variable {{token}}');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "client_id", "value": "fooddelivery-web" },
                { "key": "grant_type", "value": "password" },
                { "key": "username", "value": "customer1" },
                { "key": "password", "value": "password" }
              ]
            },
            "url": "{{keycloakUrl}}/realms/fooddelivery/protocol/openid-connect/token",
            "description": "Get JWT token from Keycloak. Token is auto-saved to {{token}} variable."
          }
        },
        {
          "name": "[Keycloak] Get Token (admin1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.access_token) {",
                  "  pm.collectionVariables.set('token', json.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "client_id", "value": "fooddelivery-web" },
                { "key": "grant_type", "value": "password" },
                { "key": "username", "value": "admin1" },
                { "key": "password", "value": "password" }
              ]
            },
            "url": "{{keycloakUrl}}/realms/fooddelivery/protocol/openid-connect/token"
          }
        },
        {
          "name": "[Customer Service] Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"Password123!\",\n  \"firstName\": \"Nguyen\",\n  \"lastName\": \"Van A\",\n  \"phone\": \"0901234567\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/register",
            "description": "Register a new customer (public endpoint, no token needed)"
          }
        },
        {
          "name": "[Customer Service] Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.accessToken) {",
                  "  pm.collectionVariables.set('token', json.accessToken);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"Password123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login",
            "description": "Login via Customer Service (custom JWT, not Keycloak)"
          }
        },
        {
          "name": "[Customer Service] Refresh Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "[Customer Service] Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "👤 Customers",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/customers/me"
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Nguyen\",\n  \"lastName\": \"Van B\",\n  \"phone\": \"0909999999\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/customers/me"
          }
        },
        {
          "name": "Get My Addresses",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/customers/me/addresses"
          }
        },
        {
          "name": "Add Address",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"label\": \"Home\",\n  \"street\": \"123 Nguyen Hue\",\n  \"district\": \"District 1\",\n  \"city\": \"Ho Chi Minh City\",\n  \"isDefault\": true\n}"
            },
            "url": "{{baseUrl}}/api/v1/customers/me/addresses"
          }
        }
      ]
    },
    {
      "name": "🍜 Restaurant",
      "item": [
        {
          "name": "List Restaurants",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/restaurant?page=0&size=10",
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Create Restaurant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pho 24\",\n  \"description\": \"Vietnamese Pho restaurant\",\n  \"address\": \"456 Le Loi, District 1, HCMC\",\n  \"phone\": \"02812345678\",\n  \"openTime\": \"07:00\",\n  \"closeTime\": \"22:00\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/restaurant"
          }
        },
        {
          "name": "Get Restaurant by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/restaurant/{{restaurantId}}"
          }
        },
        {
          "name": "Get Menu",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/restaurant/{{restaurantId}}/menu"
          }
        },
        {
          "name": "Add Menu Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Pho Bo\",\n  \"description\": \"Traditional beef noodle soup\",\n  \"price\": 75000,\n  \"currency\": \"VND\",\n  \"categoryId\": null\n}"
            },
            "url": "{{baseUrl}}/api/v1/restaurant/{{restaurantId}}/menu/items"
          }
        }
      ]
    },
    {
      "name": "📦 Orders",
      "item": [
        {
          "name": "Create Order ⭐",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.id) {",
                  "  pm.collectionVariables.set('orderId', json.id);",
                  "  console.log('Order ID saved:', json.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"restaurantId\": \"{{restaurantId}}\",\n  \"totalAmount\": 150000,\n  \"currency\": \"VND\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/orders",
            "description": "Creates an order and publishes order.placed to Kafka. orderId is auto-saved to {{orderId}}."
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}"
          }
        }
      ]
    },
    {
      "name": "💳 Payments",
      "item": [
        {
          "name": "Get Payment by Order ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/payments/order/{{orderId}}",
            "description": "Requires orderId to be set (run Create Order first)"
          }
        },
        {
          "name": "Trigger Payment Manually",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"amount\": 150000,\n  \"currency\": \"VND\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/payments",
            "description": "Manually trigger payment (normally auto-triggered by Kafka consumer)"
          }
        }
      ]
    },
    {
      "name": "🚴 Delivery",
      "item": [
        {
          "name": "Get Delivery by Order ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/delivery/order/{{orderId}}"
          }
        }
      ]
    },
    {
      "name": "🔔 Notifications",
      "item": [
        {
          "name": "Get All Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/notifications",
            "description": "Returns in-memory notification log (up to 200 latest, newest first)"
          }
        }
      ]
    },
    {
      "name": "🏥 Health Checks",
      "item": [
        {
          "name": "Gateway Health",
          "request": {
            "method": "GET",
            "url": "http://localhost:8080/actuator/health"
          }
        },
        {
          "name": "Eureka Health",
          "request": {
            "method": "GET",
            "url": "http://localhost:8761/actuator/health"
          }
        },
        {
          "name": "Config Server Health",
          "request": {
            "method": "GET",
            "url": "http://localhost:8888/actuator/health"
          }
        },
        {
          "name": "Order Service Health (direct)",
          "request": {
            "method": "GET",
            "url": "http://localhost:8083/actuator/health"
          }
        },
        {
          "name": "Payment Service Health (direct)",
          "request": {
            "method": "GET",
            "url": "http://localhost:8085/actuator/health"
          }
        },
        {
          "name": "Notification Service Health (direct)",
          "request": {
            "method": "GET",
            "url": "http://localhost:8086/actuator/health"
          }
        }
      ]
    }
  ]
}
