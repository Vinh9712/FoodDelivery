{
  "realm": "fooddelivery",
  "enabled": true,
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      { "name": "CUSTOMER", "description": "End customer placing orders" },
      { "name": "RESTAURANT", "description": "Restaurant owner / staff" },
      { "name": "DRIVER", "description": "Delivery driver" },
      { "name": "ADMIN", "description": "Platform administrator" }
    ]
  },
  "clients": [
    {
      "clientId": "fooddelivery-web",
      "name": "FoodDelivery Web/SPA client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://localhost:5173"
      ]
    },
    {
      "clientId": "fooddelivery-gateway",
      "name": "API Gateway (confidential, for direct-grant testing)",
      "enabled": true,
      "publicClient": false,
      "secret": "gateway-secret",
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false
    }
  ],
  "users": [
    {
      "username": "customer1",
      "enabled": true,
      "emailVerified": true,
      "email": "customer1@example.com",
      "firstName": "Demo",
      "lastName": "Customer",
      "credentials": [
        { "type": "password", "value": "password", "temporary": false }
      ],
      "realmRoles": ["CUSTOMER"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "emailVerified": true,
      "email": "admin1@example.com",
      "firstName": "Demo",
      "lastName": "Admin",
      "credentials": [
        { "type": "password", "value": "password", "temporary": false }
      ],
      "realmRoles": ["ADMIN"]
    }
  ]
}
